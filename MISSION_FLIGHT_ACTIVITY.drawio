              <mxPoint x="1500" y="120" />
              <mxPoint x="1330" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- NO label -->
        <mxCell id="label-no" value="NO - next point" style="text;html=1;fontSize=9;fillColor=none;align=center" vertex="1" parent="1">
          <mxGeometry x="1480" y="220" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- === INCIDENT PATH (YES) === -->

        <!-- SIM9: Create Incident -->
        <mxCell id="sim9" value="1. CREATE Incident&#10;2. MaintenanceAlert&#10;3. status = INCIDENT_RETURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2.5;fontSize=9;fontStyle=bold" vertex="1" parent="sl-sim">
          <mxGeometry x="1680" y="330" width="120" height="80" as="geometry" />
