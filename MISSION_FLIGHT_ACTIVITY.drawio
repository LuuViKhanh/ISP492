        </mxCell>

        <!-- ========== PATH YES: INCIDENT HANDLING ========== -->

        <!-- S9: Create Incident -->
        <mxCell id="s9" value="1. CREATE Incident&#10;2. MaintenanceAlert&#10;3. Set status =&#10;INCIDENT_RETURN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2.5;fontSize=9;fontStyle=bold" vertex="1" parent="sl-sim">
