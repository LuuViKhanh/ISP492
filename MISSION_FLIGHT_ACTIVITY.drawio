        <mxCell id="sys1" value="📢 SEND Notification&#10;to Operators:&#10;⚠️  Incident Alert&#10;Mission {id} at ({lat},{lng})" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=8" vertex="1" parent="sl-sys">
          <mxGeometry x="1680" y="1020" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e21" edge="1" parent="1" source="db3" target="sys1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM10: Interpolate return path -->
        <mxCell id="sim10" value="Interpolate Return Path:&#10;incident_point&#10;→ from_hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="1810" y="330" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e22" edge="1" parent="1" source="sim9" target="sim10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM11: Fly return path -->
        <mxCell id="sim11" value="FOR return_waypoint:&#10;• Sleep 3s&#10;• Calc sensors&#10;• Insert telemetry&#10;• Update battery" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=8" vertex="1" parent="sl-sim">
          <mxGeometry x="1810" y="430" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="sim10" target="sim11">
