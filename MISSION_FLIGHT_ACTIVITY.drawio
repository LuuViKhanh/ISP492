            <mxPoint x="290" y="375" as="sourcePoint" />
            <mxPoint x="380" y="375" as="targetPoint" />
          </mxGeometry>
        

        </mxCell>

        <!-- YES label -->
        <mxCell id="label-yes2" value="YES" style="text;html=1;fontSize=9;fillColor=none" vertex="1" parent="1">
          <mxGeometry x="330" y="360" width="30" height="20" as="geometry" />
        </mxCell>

        <!-- A3: Technician sees AT_HUB -->
        <mxCell id="a3" value="See: Drone at Hub,&#10;Ready to swap battery&#10;&amp; dispatch next" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-tech">
