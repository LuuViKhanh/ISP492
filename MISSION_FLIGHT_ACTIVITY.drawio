        </mxCell>

        <!-- DB4: Drone landed at from_hub -->
        <mxCell id="db4" value="UPDATE Drone:&#10;current_hub_id = from_hub&#10;handling_status =&#10;CANNOT_CONTINUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
          <mxGeometry x="1810" y="820" width="120" height="80" as="geometry" />
