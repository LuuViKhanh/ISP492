        <!-- SIM13: Decision - More legs? -->
        <mxCell id="sim13" value="Any PENDING&#10;Legs?" style="rhombus;whiteSpace=wrap;html=1;fillColor#FFD700;strokeColor#FF8C00;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
