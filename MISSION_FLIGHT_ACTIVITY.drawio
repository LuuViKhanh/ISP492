        <mxCell id="db5" value="UPDATE Drone:&#10;current_hub_id = to_hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor#B0E0E6;strokeColor#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
          <mxGeometry x="50" y="820" width="100" height="80" as="geometry" />
