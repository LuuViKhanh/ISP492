        <!-- === NORMAL COMPLETION (NO INCIDENT) === -->

        <!-- SIM12: All waypoints done -->
        <mxCell id="sim12" value="All Waypoints Done" style="rounded=1;whiteSpace=wrap;html=1;fillColor#87CEEB;strokeColor#4682B4;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="50" y="350" width="100" height="60" as="geometry" />
