<mxfile host="app.diagrams.net" modified="2026-10-18T12:00:00.000Z" agent="Mozilla/5.0" etag="diagram-h" version="24.0.0" type="device">
  <diagram id="activity-mission" name="Activity: Mission Flight &amp; Emergency (Horizontal)">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========== SWIMLANES (Horizontal) ========== -->
        
        <!-- Swimlane 1: Technician (Top) -->
        <mxCell id="sl-tech" value="👨‍💼 Technician" style="swimlane;startSize=40;horizontal=1;strokeColor=#333333;fillColor=#E8F4F8;fontSize=12;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="0" width="2200" height="200" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: API/Router (Second) -->
        <mxCell id="sl-api" value="🔌 API Router (dispatch_drone)" style="swimlane;startSize=40;horizontal=1;strokeColor=#333333;fillColor=#E6E6FA;fontSize=12;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="200" width="2200" height="180" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: Simulator (Third) -->
        <mxCell id="sl-sim" value="🔄 Simulator (simulate_mission_flight)" style="swimlane;startSize=40;horizontal=1;strokeColor=#333333;fillColor=#F8E8E8;fontSize=12;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="380" width="2200" height="420" as="geometry" />
        </mxCell>

        <!-- Swimlane 4: Database (Bottom) -->
        <mxCell id="sl-db" value="💾 Database" style="swimlane;startSize=40;horizontal=1;strokeColor=#333333;fillColor=#E8F8E8;fontSize=12;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="800" width="2200" height="200" as="geometry" />
        </mxCell>

        <!-- Swimlane 5: System (Bottom) -->
        <mxCell id="sl-sys" value="🔔 System (Notifications)" style="swimlane;startSize=40;horizontal=1;strokeColor=#333333;fillColor=#F8F8E8;fontSize=12;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="1000" width="2200" height="200" as="geometry" />
        </mxCell>

        <!-- ========== FLOW ========== -->

        <!-- START -->
        <mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#90EE90;strokeColor=#000000;strokeWidth=2;fontSize=11" vertex="1" parent="sl-tech">
          <mxGeometry x="20" y="70" width="70" height="50" as="geometry" />
        </mxCell>

        <!-- A1: Technician clicks dispatch -->
        <mxCell id="a1" value="Click Dispatch Button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4B5;strokeColor=#FF8C00;strokeWidth=2;fontSize=10" vertex="1" parent="sl-tech">
          <mxGeometry x="120" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S1: API dispatch_drone -->
        <mxCell id="s1" value="POST /dispatch&#10;{mission_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6FA;strokeColor=#4B0082;strokeWidth=2;fontSize=10" vertex="1" parent="sl-api">
          <mxGeometry x="120" y="65" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="a1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S2: Validate mission state -->
        <mxCell id="s2" value="Validate Mission State&#10;(status=PENDING, leg ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor=#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-api">
          <mxGeometry x="240" y="65" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S3: Update mission status -->
        <mxCell id="s3" value="UPDATE Mission&#10;status = FLYING" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor=#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-api">
          <mxGeometry x="370" y="65" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S4: Create async task -->
        <mxCell id="s4" value="asyncio.create_task(&#10;simulate_mission_flight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor=#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-api">
          <mxGeometry x="490" y="65" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S5: Return 200 OK -->
        <mxCell id="s5" value="Return 200 OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor=#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-api">
          <mxGeometry x="620" y="65" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- A2: Technician sees confirmation -->
        <mxCell id="a2" value="See confirmation:&#10;Drone dispatched" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFE4B5;strokeColor=#FF8C00;strokeWidth=1;fontSize=9" vertex="1" parent="sl-tech">
          <mxGeometry x="620" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="s5" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === START BACKGROUND SIMULATOR === -->

        <!-- SIM1: Get mission + leg -->
        <mxCell id="sim1" value="GET Mission WHERE&#10;status=FLYING &amp;&#10;MissionLeg IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor#B0E0E6;strokeColor=#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="710" y="80" width="120" height="80" as="geometry" />
        </mxCell>
        <!-- Connection from API async task to simulator -->
        <mxCell id="e8" edge="1" parent="1" source="s4" target="sim1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="125" as="sourcePoint" />
            <mxPoint x="710" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- SIM2: Extract hub coordinates -->
        <mxCell id="sim2" value="Extract Hub Coordinates&#10;(from_hub, to_hub)&#10;lat, lng" style="rounded=1;whiteSpace=wrap;html=1;fillColor#87CEEB;strokeColor#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="850" y="80" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="sim1" target="sim2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM3: Interpolate waypoints -->
        <mxCell id="sim3" value="Interpolate 20 Waypoints&#10;(haversine distance&#10;from_hub → to_hub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFA500;strokeColor#FF4500;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="990" y="80" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="sim2" target="sim3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM4: Get battery info -->
        <mxCell id="sim4" value="Get Battery Info&#10;capacity_wh,&#10;charge_level_pct" style="rounded=1;whiteSpace=wrap;html=1;fillColor#B0E0E6;strokeColor#4682B4;strokeWidth=1;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="1140" y="80" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="sim3" target="sim4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM5: Loop - FOR each waypoint -->
        <mxCell id="sim5" value="FOR each waypoint&#10;in interpolated_path:" style="rounded=1;whiteSpace=wrap;html=1;fillColor#DDA0DD;strokeColor#8B008B;strokeWidth=2;fontSize=10;fontStyle=bold" vertex="1" parent="sl-sim">
          <mxGeometry x="1270" y="80" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="sim4" target="sim5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM6: Sleep interval -->
        <mxCell id="sim6" value="await asyncio.sleep&#10;(INTERVAL_SEC = 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFDAB9;strokeColor#FF6347;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="1410" y="80" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="sim5" target="sim6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM7: Calculate sensor values -->
        <mxCell id="sim7" value="Calculate Sensor Values:&#10;• altitude, speed, wind&#10;• battery_volt&#10;• energy consumption" style="rounded=1;whiteSpace=wrap;html=1;fillColor#87CEEB;strokeColor#4682B4;strokeWidth=2;fontSize=8" vertex="1" parent="sl-sim">
          <mxGeometry x="1540" y="80" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="sim6" target="sim7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DB1: Fetch weather + Insert telemetry -->
        <mxCell id="db1" value="1. Fetch Weather&#10;2. INSERT TelemetryLog&#10;(lat, lng, alt, speed,&#10;battery, weather)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#98FB98;strokeColor#228B22;strokeWidth=2;fontSize=8" vertex="1" parent="sl-db">
