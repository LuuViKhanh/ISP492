        </mxCell>

        <!-- D5: Drone Landed at from_hub -->
        <mxCell id="d5" value="UPDATE Drone:&#10;• current_hub_id =&#10;from_hub.id&#10;• handling_status =&#10;CANNOT_CONTINUE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
