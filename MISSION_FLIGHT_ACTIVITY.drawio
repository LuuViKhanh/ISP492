        <!-- DB2: Update battery level -->
        <mxCell id="db2" value="UPDATE Battery &amp;&#10;Drone set charge_level_pct" style="rounded=1;whiteSpace=wrap;html=1;fillColor#B0E0E6;strokeColor#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
          <mxGeometry x="1670" y="820" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="db1" target="db2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SIM8: Decision - Incident? -->
        <mxCell id="sim8" value="Incident?&#10;random() &lt;&#10;probability" style="rhombus;whiteSpace=wrap;html=1;fillColor#FFD700;strokeColor#FF8C00;strokeWidth=2.5;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="1680" y="200" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="sim7" target="sim8">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1600" y="160" as="sourcePoint" />
            <mxPoint x="1730" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- PATH: NO - Loop back -->
        <mxCell id="e18" edge="1" parent="1" source="sim8" target="sim5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1680" y="250" as="sourcePoint" />
            <mxPoint x="1330" y="160" as="targetPoint" />
            <Array as="points">
