        <!-- SYS1: Send Notification to Operators -->
        <mxCell id="sys1" value="📢 SEND Notification&#10;to Operators:&#10;⚠️  Mission {id}&#10;Incident at ({lat},{lng})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sys">
          <mxGeometry x="920" y="1150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="d4" target="sys1">
