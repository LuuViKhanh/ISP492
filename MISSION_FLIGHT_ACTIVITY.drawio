        <!-- S11: Fly Return Path -->
        <mxCell id="s11" value="FOR each waypoint&#10;in return_path:&#10;• Sleep 3s&#10;• Calc sensors&#10;• Insert telemetry&#10;• Update battery %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
