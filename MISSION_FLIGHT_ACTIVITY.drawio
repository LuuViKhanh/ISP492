          </mxGeometry>
        </mxCell>

        <!-- END Incident -->
        <mxCell id="end-incident" value="END: Incident&#10;Technician Inspects" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=10;fontStyle=bold" vertex="1" parent="sl-sim">
          <mxGeometry x="1810" y="550" width="110" height="60" as="geometry" />
