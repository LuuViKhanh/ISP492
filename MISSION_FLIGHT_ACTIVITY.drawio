        <!-- YES - More legs: AT_HUB -->
        <mxCell id="sim14" value="Set handling_status = AT_HUB&#10;(Technician can swap battery&#10;&amp; dispatch next leg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor#87CEEB;strokeColor#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="380" y="330" width="120" height="90" as="geometry" />
