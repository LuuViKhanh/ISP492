<mxfile host="app.diagrams.net" modified="2026-10-18T11:00:00.000Z" agent="Mozilla/5.0" etag="diagram1" version="24.0.0" type="device">
  <diagram id="activity-mission" name="Activity: Mission Flight &amp; Emergency">
    <mxGraphModel dx="1400" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========== SWIMLANES ========== -->
        <!-- Swimlane: Technician -->
        <mxCell id="sl-tech" value="👨‍💼 Technician" style="swimlane;startSize=40;horizontal=0;strokeColor=#333333;fillColor=#E8F4F8;fontSize=13;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry y="0" width="150" height="2200" as="geometry" />
        </mxCell>

        <!-- Swimlane: Simulator -->
        <mxCell id="sl-sim" value="🔄 Simulator (Server)" style="swimlane;startSize=40;horizontal=0;strokeColor=#333333;fillColor=#F8E8E8;fontSize=13;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry x="150" y="0" width="400" height="2200" as="geometry" />
        </mxCell>

        <!-- Swimlane: Database -->
        <mxCell id="sl-db" value="💾 Database" style="swimlane;startSize=40;horizontal=0;strokeColor=#333333;fillColor=#E8F8E8;fontSize=13;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry x="550" y="0" width="350" height="2200" as="geometry" />
        </mxCell>

        <!-- Swimlane: System -->
        <mxCell id="sl-sys" value="🔔 System/Operators" style="swimlane;startSize=40;horizontal=0;strokeColor=#333333;fillColor=#F8F8E8;fontSize=13;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry x="900" y="0" width="300" height="2200" as="geometry" />
        </mxCell>

        <!-- ========== FLOW: NORMAL PATH ========== -->

        <!-- START -->
        <mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#90EE90;strokeColor=#000000;strokeWidth=2" vertex="1" parent="sl-tech">
          <mxGeometry x="20" y="50" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- A1: Click Dispatch -->
        <mxCell id="a1" value="Click Dispatch Button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4B5;strokeColor=#FF8C00;strokeWidth=2;fontSize=11" vertex="1" parent="sl-tech">
          <mxGeometry x="20" y="150" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S1: API Call -->
        <mxCell id="s1" value="POST /dispatch&#10;mission_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6FA;strokeColor=#4B0082;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="150" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="a1" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S2: Async Task -->
        <mxCell id="s2" value="asyncio.create_task(&#10;simulate_mission_flight)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#C71585;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="260" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D1: Get Mission + Leg -->
        <mxCell id="d1" value="Get Mission WHERE&#10;status=FLYING &amp;&#10;MissionLeg IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E0E6;strokeColor=#4682B4;strokeWidth=2;fontSize=10" vertex="1" parent="sl-db">
          <mxGeometry x="580" y="260" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="s2" target="d1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="295" as="sourcePoint" />
            <mxPoint x="550" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- S3: Extract Hub Info -->
        <mxCell id="s3" value="Extract from_hub &amp;&#10;to_hub coordinates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#87CEEB;strokeColor=#4682B4;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="380" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="d1" target="s3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="295" as="sourcePoint" />
            <mxPoint x="320" y="415" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- S4: Interpolate Waypoints -->
        <mxCell id="s4" value="Interpolate 20 waypoints&#10;between from_hub → to_hub&#10;(haversine distance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFA500;strokeColor=#FF4500;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="500" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D2: Get Battery Info -->
        <mxCell id="d2" value="SELECT Battery:&#10;• capacity_wh&#10;• charge_level_pct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E0E6;strokeColor=#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
          <mxGeometry x="580" y="500" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="s4" target="d2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="540" as="sourcePoint" />
            <mxPoint x="550" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- S5: LOOP Start -->
        <mxCell id="s5" value="FOR each waypoint&#10;in interpolated_path:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDA0DD;strokeColor=#8B008B;strokeWidth=2;fontSize=10;fontStyle=bold" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="630" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="d2" target="s5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="540" as="sourcePoint" />
            <mxPoint x="320" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- S6: Sleep Interval -->
        <mxCell id="s6" value="await asyncio.sleep&#10;(INTERVAL_SEC = 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFDAB9;strokeColor=#FF6347;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="750" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- S7: Calculate Sensor Values -->
        <mxCell id="s7" value="Calculate Sensor Values:&#10;• altitude, speed, wind&#10;• battery_volt&#10;• energy consumption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#87CEEB;strokeColor=#4682B4;strokeWidth=2;fontSize=9" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="870" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- D3: Fetch Weather + Telemetry -->
        <mxCell id="d3" value="1. Fetch Weather&#10;2. INSERT TelemetryLog&#10;3. UPDATE Battery/Drone&#10;charge_level_pct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#98FB98;strokeColor=#228B22;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
