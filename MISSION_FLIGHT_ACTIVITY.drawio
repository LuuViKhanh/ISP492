        <!-- YES label -->
        <mxCell id="label-yes" value="YES - incident!" style="text;html=1;fontSize=9;fillColor=none;align=center;fontColor=#DC143C;fontStyle=bold" vertex="1" parent="1">
          <mxGeometry x="1740" y="300" width="70" height="20" as="geometry" />
        </mxCell>

        <!-- DB3: Update Mission Incident -->
        <mxCell id="db3" value="UPDATE Mission:&#10;status = INCIDENT_RETURN&#10;handling_status = INCOMING" style="rounded=1;whiteSpace=wrap;html=1;fillColor#FFB6C1;strokeColor#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
