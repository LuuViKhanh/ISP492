        <!-- S10: Interpolate Return Path -->
        <mxCell id="s10" value="Interpolate Return Path:&#10;incident_point&#10;→ from_hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2;fontSize=10" vertex="1" parent="sl-sim">
          <mxGeometry x="180" y="1290" width="140" height="70" as="geometry" />
