          <mxGeometry x="290" y="1110" width="40" height="30" as="geometry" />
        </mxCell>

        <!-- D4: Update Mission -->
        <mxCell id="d4" value="UPDATE Mission:&#10;• status = INCIDENT_RETURN&#10;• handling_status =&#10;INCOMING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB6C1;strokeColor=#DC143C;strokeWidth=2;fontSize=9" vertex="1" parent="sl-db">
