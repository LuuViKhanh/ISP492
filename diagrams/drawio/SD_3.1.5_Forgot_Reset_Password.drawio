        <mxCell id="ab_email" value="" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1"><mxGeometry x="1202" y="493" width="12" height="40" as="geometry"/></mxCell>

        <!-- === PHASE 1: FORGOT PASSWORD === -->
        <mxCell id="ph1_lbl" value="Phase 1: Forgot Password — POST /api/v1/auth/forgot-password" parent="1" style="text;html=1;strokeColor=#999999;fillColor=none;align=left;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry x="40" y="175" width="450" height="20" as="geometry"/></mxCell>
        <mxCell id="m1" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="1. Enter email address"><mxGeometry relative="1" y="10" as="geometry"><mxPoint as="offset"/><mxPoint x="60" y="200" as="sourcePoint"/><mxPoint x="249" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="2. POST /api/v1/auth/forgot-password  { email }"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="261" y="238" as="sourcePoint"/><mxPoint x="492" y="238" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="3. create_reset_token(db, email)"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="504" y="278" as="sourcePoint"/><mxPoint x="727" y="278" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="4. SELECT Account WHERE email = :email"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="315" as="sourcePoint"/><mxPoint x="962" y="315" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="5. user (or None — silent if not found)"><mxGeometry relative="1" as="geometry"><mxPoint x="962" y="353" as="sourcePoint"/><mxPoint x="739" y="353" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="6. token = secrets.token_urlsafe(32)  [expires 15 min]"><mxGeometry relative="1" y="10" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="390" as="sourcePoint"/><mxPoint x="962" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="7. UPDATE Account SET reset_token, reset_token_expires_at"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="425" as="sourcePoint"/><mxPoint x="962" y="425" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="8. send_reset_email(to=email, link=FRONTEND_URL/reset-password?token=...)"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="504" y="498" as="sourcePoint"/><mxPoint x="1202" y="498" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="9. 200 OK — 'If this email exists, a reset link has been sent.'"><mxGeometry relative="1" y="-15" as="geometry"><mxPoint as="offset"/><mxPoint x="492" y="545" as="sourcePoint"/><mxPoint x="261" y="545" as="targetPoint"/></mxGeometry></mxCell>

        <!-- === PHASE 2: RESET PASSWORD === -->
        <mxCell id="ph2_lbl" value="Phase 2: Reset Password — POST /api/v1/auth/reset-password" parent="1" style="text;html=1;strokeColor=#999999;fillColor=none;align=left;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry x="40" y="575" width="450" height="20" as="geometry"/></mxCell>
        <mxCell id="m10" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="10. Click reset link, enter new password"><mxGeometry relative="1" y="10" as="geometry"><mxPoint as="offset"/><mxPoint x="60" y="600" as="sourcePoint"/><mxPoint x="249" y="600" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="11. POST /api/v1/auth/reset-password  { token, new_password }"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="261" y="638" as="sourcePoint"/><mxPoint x="492" y="638" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="12. reset_password(db, token, new_password)"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="504" y="678" as="sourcePoint"/><mxPoint x="727" y="678" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="13. SELECT Account WHERE reset_token = :token AND expires_at &gt; now()"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="715" as="sourcePoint"/><mxPoint x="962" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="14. user (or None)"><mxGeometry relative="1" as="geometry"><mxPoint x="962" y="753" as="sourcePoint"/><mxPoint x="739" y="753" as="targetPoint"/></mxGeometry></mxCell>

        <!-- ALT FRAME -->
        <mxCell id="alt_frame" value="" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1"><mxGeometry x="40" y="773" width="1360" height="310" as="geometry"/></mxCell>
        <mxCell id="alt_lbl" value="alt" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1"><mxGeometry x="40" y="773" width="45" height="24" as="geometry"/></mxCell>

        <!-- Lane failed -->
        <mxCell id="f_lbl" value="[Reset token invalid or expired]" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;" vertex="1"><mxGeometry x="90" y="774" width="280" height="22" as="geometry"/></mxCell>
        <mxCell id="f15" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="15. raise HTTPException 400"><mxGeometry relative="1" y="-15" as="geometry"><mxPoint as="offset"/><mxPoint x="727" y="818" as="sourcePoint"/><mxPoint x="492" y="818" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="f16" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="16. 400 Bad Request — Invalid or expired token"><mxGeometry relative="1" y="-15" as="geometry"><mxPoint as="offset"/><mxPoint x="492" y="853" as="sourcePoint"/><mxPoint x="261" y="853" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="f17" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="17. Show error — Token expired or invalid"><mxGeometry relative="1" as="geometry"><mxPoint x="249" y="888" as="sourcePoint"/><mxPoint x="60" y="888" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Divider -->
        <mxCell id="div1" edge="1" parent="1" style="endArrow=none;dashed=1;strokeColor=#000000;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="910" as="sourcePoint"/><mxPoint x="1400" y="910" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s_lbl" value="[else: Token valid]" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontStyle=2;fontColor=#2d6a2d;" vertex="1"><mxGeometry x="90" y="911" width="180" height="22" as="geometry"/></mxCell>

        <!-- Success lane -->
        <mxCell id="s18" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="18. hash_password(new_password)  [bcrypt]"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="943" as="sourcePoint"/><mxPoint x="962" y="943" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s19" edge="1" parent="1" style="endArrow=block;endFill=1;strokeColor=#000000;fontSize=11;" value="19. UPDATE Account SET password_hash, reset_token=NULL, reset_token_expires_at=NULL"><mxGeometry relative="1" y="15" as="geometry"><mxPoint as="offset"/><mxPoint x="739" y="978" as="sourcePoint"/><mxPoint x="962" y="978" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s20" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="20. Return True"><mxGeometry relative="1" as="geometry"><mxPoint x="727" y="1018" as="sourcePoint"/><mxPoint x="504" y="1018" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s21" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="21. 200 OK — Password reset successfully"><mxGeometry relative="1" y="-15" as="geometry"><mxPoint as="offset"/><mxPoint x="492" y="1058" as="sourcePoint"/><mxPoint x="261" y="1058" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s22" edge="1" parent="1" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=11;" value="22. Show success — Redirect to login"><mxGeometry relative="1" as="geometry"><mxPoint x="249" y="1093" as="sourcePoint"/><mxPoint x="60" y="1093" as="targetPoint"/></mxGeometry></mxCell>

