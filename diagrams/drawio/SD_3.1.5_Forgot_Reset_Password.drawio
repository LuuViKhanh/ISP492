        <mxCell id="ll3" edge="1" parent="1" style="endArrow=none;dashed=1;strokeColor=#000000;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="498" y="125" as="sourcePoint"/><mxPoint x="498" y="1240" as="targetPoint"/></mxGeometry></mxCell>
