        <mxCell id="h_account" value=":Account (DB)" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry x="900" y="80" width="135" height="45" as="geometry"/></mxCell>
        <mxCell id="h_email" value=":EmailService" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry x="1140" y="80" width="135" height="45" as="geometry"/></mxCell>

