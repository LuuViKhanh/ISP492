        <mxCell id="ll1" edge="1" parent="1" style="endArrow=none;dashed=1;strokeColor=#000000;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="150" as="sourcePoint"/><mxPoint x="60" y="1240" as="targetPoint"/></mxGeometry></mxCell>
